{
  "openapi": "3.1.0",
  "info": {
    "title": "Trafiku Urban Public API (research draft)",
    "version": "0.1.0",
    "description": "Unofficial contract reconstructed from the public Android client and verified with anonymous requests on 2026-07-14. Field meanings and stability require owner confirmation before publication."
  },
  "servers": [
    {
      "url": "https://tu.appbites.dev/api/public"
    }
  ],
  "paths": {
    "/stations": {
      "get": {
        "operationId": "listStations",
        "summary": "List stations",
        "responses": {
          "200": {
            "description": "Station collection",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/Station" }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/stations/{stationId}": {
      "get": {
        "operationId": "getStation",
        "summary": "Get one station",
        "parameters": [
          { "$ref": "#/components/parameters/StationId" }
        ],
        "responses": {
          "200": {
            "description": "Station or application-level error envelope",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/Envelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "oneOf": [
                            { "$ref": "#/components/schemas/Station" },
                            { "type": "string" }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/stations/{stationId}/incomingBuses": {
      "post": {
        "operationId": "getIncomingBuses",
        "summary": "Get buses approaching a station",
        "parameters": [
          { "$ref": "#/components/parameters/StationId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserContext" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Station distance, passing lines, and approaching buses",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "cached": { "type": "boolean" },
                        "data": { "$ref": "#/components/schemas/IncomingData" }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/schedules/{lineId}/{stationId}": {
      "get": {
        "operationId": "getSchedule",
        "summary": "Get a line schedule at a station",
        "parameters": [
          { "$ref": "#/components/parameters/LineId" },
          { "$ref": "#/components/parameters/StationId" }
        ],
        "responses": {
          "200": {
            "description": "Schedule, or a success=false envelope when none exists",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/Envelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "oneOf": [
                            { "$ref": "#/components/schemas/Schedule" },
                            { "type": "string" }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/news/{limit}/{page}": {
      "get": {
        "operationId": "listNews",
        "summary": "List paginated service news",
        "parameters": [
          {
            "name": "limit",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "minimum": 1 },
            "description": "Page size; the Android client uses 10."
          },
          {
            "name": "page",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "minimum": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated news",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/NewsPage" }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/buses/{busId}/upcomingStations": {
      "post": {
        "operationId": "getUpcomingStations",
        "summary": "Get passed and upcoming stations for a live bus",
        "parameters": [
          { "$ref": "#/components/parameters/BusId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserContext" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Route geometry and station progress",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "cached": { "type": "boolean" },
                        "data": { "$ref": "#/components/schemas/UpcomingData" }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "StationId": {
        "name": "stationId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "LineId": {
        "name": "lineId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "BusId": {
        "name": "busId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "Transient live-bus identifier from bus_update or incoming_buses."
      }
    },
    "schemas": {
      "Envelope": {
        "type": "object",
        "required": ["success", "data"],
        "properties": {
          "success": { "type": "boolean" },
          "data": {}
        },
        "additionalProperties": true
      },
      "SuccessEnvelope": {
        "type": "object",
        "required": ["success", "data"],
        "properties": {
          "success": { "const": true },
          "data": {}
        },
        "additionalProperties": true
      },
      "Point": {
        "type": "object",
        "required": ["type", "coordinates"],
        "properties": {
          "type": { "const": "Point" },
          "coordinates": {
            "type": "array",
            "prefixItems": [
              { "type": "number", "minimum": -180, "maximum": 180 },
              { "type": "number", "minimum": -90, "maximum": 90 }
            ],
            "minItems": 2,
            "maxItems": 2,
            "description": "[longitude, latitude]"
          }
        }
      },
      "LineString": {
        "type": "object",
        "required": ["type", "coordinates"],
        "properties": {
          "type": { "type": "string" },
          "coordinates": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 3
            }
          }
        },
        "additionalProperties": true
      },
      "Station": {
        "type": "object",
        "required": ["_id", "name", "geometry", "lines"],
        "properties": {
          "_id": { "type": "string" },
          "unique_id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "geometry": { "$ref": "#/components/schemas/Point" },
          "lines": {
            "type": "array",
            "items": { "type": "string" }
          },
          "created_date": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": true
      },
      "UserContext": {
        "type": "object",
        "required": ["location", "userId"],
        "properties": {
          "location": {
            "type": "array",
            "prefixItems": [
              { "type": "number", "minimum": -180, "maximum": 180 },
              { "type": "number", "minimum": -90, "maximum": 90 }
            ],
            "minItems": 2,
            "maxItems": 2,
            "description": "Caller position as [longitude, latitude]."
          },
          "userId": {
            "type": "string",
            "default": "unknown",
            "description": "The anonymous Android flow sends 'unknown'."
          }
        },
        "additionalProperties": false
      },
      "PassingLine": {
        "type": "object",
        "required": ["_id", "bus_sign", "color"],
        "properties": {
          "_id": { "type": "string" },
          "bus_sign": { "type": "string" },
          "color": { "type": "string" }
        },
        "additionalProperties": true
      },
      "IncomingBus": {
        "type": "object",
        "required": ["_id", "line_id", "line_sign"],
        "properties": {
          "_id": { "type": "string" },
          "color": { "type": "string" },
          "street": { "type": "string" },
          "address": { "type": "string" },
          "heading": { "type": "number" },
          "distance_from_station_km": { "type": "string" },
          "distance_from_station_min": {
            "oneOf": [{ "type": "integer" }, { "type": "string" }]
          },
          "line_sign": { "type": "string" },
          "line_color": { "type": "string" },
          "line_id": { "type": "string" },
          "direction_towards": { "type": "string" }
        },
        "additionalProperties": true
      },
      "IncomingData": {
        "type": "object",
        "required": ["station_id", "station_name", "station_coordinates", "passing_lines", "incoming_buses"],
        "properties": {
          "station_id": { "type": "string" },
          "station_name": { "type": "string" },
          "station_coordinates": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "distance_in_km": { "type": "string" },
          "distance_in_minutes": {
            "oneOf": [{ "type": "integer" }, { "type": "string" }]
          },
          "passing_lines": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PassingLine" }
          },
          "incoming_buses": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/IncomingBus" }
          }
        },
        "additionalProperties": true
      },
      "Schedule": {
        "type": "object",
        "required": ["_id", "week", "weekend", "station", "line"],
        "properties": {
          "_id": { "type": "string" },
          "week": {
            "type": "array",
            "items": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" }
          },
          "weekend": {
            "type": "array",
            "items": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" }
          },
          "station": { "type": "string" },
          "line": { "type": "string" }
        },
        "additionalProperties": true
      },
      "NewsItem": {
        "type": "object",
        "required": ["_id", "title", "description"],
        "properties": {
          "_id": { "type": "string" },
          "title": { "type": "string" },
          "description": {
            "type": "string",
            "description": "May contain HTML. Treat as untrusted content when rendering."
          },
          "short_description": { "type": "string" },
          "photo": { "type": "string", "format": "uri" },
          "created_date": { "type": "string", "format": "date-time" },
          "updated_date": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": true
      },
      "NewsPage": {
        "type": "object",
        "required": ["docs", "totalDocs", "limit", "page", "totalPages"],
        "properties": {
          "docs": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/NewsItem" }
          },
          "totalDocs": { "type": "integer" },
          "limit": { "type": "integer" },
          "page": { "type": "integer" },
          "totalPages": { "type": "integer" },
          "hasNextPage": { "type": "boolean" },
          "hasPrevPage": { "type": "boolean" },
          "nextPage": { "type": ["integer", "null"] },
          "prevPage": { "type": ["integer", "null"] },
          "pagingCounter": { "type": "integer" }
        },
        "additionalProperties": true
      },
      "RouteStation": {
        "type": "object",
        "required": ["_id", "name", "line_id", "line_sign"],
        "properties": {
          "_id": { "type": "string" },
          "name": { "type": "string" },
          "distance_to_station_km": { "type": "string" },
          "distance_to_station_min": {
            "oneOf": [{ "type": "integer" }, { "type": "string" }]
          },
          "line_sign": { "type": "string" },
          "line_color": { "type": "string" },
          "line_id": { "type": "string" },
          "direction_towards": { "type": "string" }
        },
        "additionalProperties": true
      },
      "UpcomingData": {
        "type": "object",
        "required": ["line_geometry", "passed_stations", "upcoming_stations"],
        "properties": {
          "line_geometry": { "$ref": "#/components/schemas/LineString" },
          "passed_stations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/RouteStation" }
          },
          "upcoming_stations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/RouteStation" }
          }
        },
        "additionalProperties": true
      }
    }
  }
}
